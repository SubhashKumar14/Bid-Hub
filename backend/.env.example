# =========================
# SERVER
# =========================
NODE_ENV=production
# Transactions require a MongoDB replica set, not a standalone server.
# Set PRIVATE_UPLOAD_DIR to an absolute path on a durable private volume to enable
# production attachments. Without it, only attachment endpoints return 503.
# Live Razorpay keys are disabled until payout/refund operations are implemented.
PORT=5000

# =========================
# DATABASE
# =========================
# Get your free cluster at https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/bidhub?retryWrites=true&w=majority

# =========================
# JWT
# =========================
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_randomly_generated_secret_key_minimum_32_chars
JWT_EXPIRE=1d

# =========================
# PAYMENTS (Razorpay Test Mode for demonstrations)
# =========================
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=rzp_test_replace_with_key_id
RAZORPAY_KEY_SECRET=replace_with_test_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_webhook_secret

# =========================
# CLOUDINARY (required in production; optional for local development)
# =========================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=bidhub

# =========================
# CLIENT URL (set to your Vercel frontend URL in production)
# =========================
CLIENT_URL=https://your-app.vercel.app

# =========================
# FILE IMPORT LIMITS
# =========================
MAX_PROJECT_FILES=20
MAX_PROJECT_SIZE_MB=50
